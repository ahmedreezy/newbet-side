# GitHub webhook secret (set same value in GitHub repo Settings → Webhooks)
WEBHOOK_SECRET=replace_with_random_secret

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/newbet

# JWT secret — use a random 64-character string
JWT_SECRET=replace_with_64_char_random_string

# Token expiry
JWT_EXPIRES_IN=12h

# Initial admin password (used once by db:seed — min 12 characters)
ADMIN_INITIAL_PASSWORD=replace_with_strong_password_12chars_min

# API key for live scores (optional)
SCORES_API_KEY=

# Football API key (api-football.com)
FOOTBALL_API_KEY=32d11afcf94ce079fb5a0e79a21948a2

# Allowed CORS origin for production
ALLOWED_ORIGIN=https://almaxpredictions.com
